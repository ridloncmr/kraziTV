{
  "name": "krazitv",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agents:check": "node .claude/sync-skills.mjs --check",
    "agents:sync": "node .claude/sync-skills.mjs",
    "build": "tsc -b tsconfig.build.json && npm run build --workspace @krazitv/web",
    "build:node": "tsc -b tsconfig.build.json",
    "dev": "npm run dev --workspace @krazitv/server",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b tsconfig.build.json && npm run typecheck --workspace @krazitv/web"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}
