# Copy this file to .env in the same folder. kraziTV reads it at startup;
# variables already set in the environment win over it. Restart kraziTV after
# changing it.

# Server binding
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173

# The origin Plex reaches kraziTV at. Every tuner, lineup, and stream URL is
# built on it; set it whenever Plex runs on another machine. Defaults to
# http://127.0.0.1:PORT.
# PUBLIC_BASE_URL=http://192.168.1.10:3000

# Local runtime state; relative paths resolve from the process working directory.
KRAZITV_DATA_DIR=./data

# The timezone programming rules are evaluated in; defaults to the host's.
# KRAZITV_PROGRAMMING_TIMEZONE=America/New_York

# HDHomeRun identity advertised to Plex. The device ID must be eight hex digits.
# KRAZITV_DEVICE_ID=4B5A5456
# KRAZITV_TUNER_COUNT=2

# FFmpeg and ffprobe executables; default to the ones on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# The font the filler screen is rendered with; defaults to Arial on Windows
# and fontconfig's default elsewhere.
# FFMPEG_FONT_FILE=C:\Windows\Fonts\arial.ttf

# Catalog scan probing: how long one ffprobe may run and how many run at once.
# FFPROBE_TIMEOUT_MS=30000
# FFPROBE_CONCURRENCY=4
