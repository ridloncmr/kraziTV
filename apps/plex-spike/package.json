{
  "name": "@krazitv/plex-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "tsx src/generate-assets.ts",
    "build": "tsc -b",
    "predev": "tsc -b ../../packages/signal/tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "test:ffmpeg": "vitest run integration/real-ffmpeg.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.integration.json"
  },
  "dependencies": {
    "@krazitv/signal": "file:../../packages/signal",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.20.5"
  }
}
